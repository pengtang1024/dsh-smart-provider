{
  "name": "dsh-smart-provider",
  "displayName": "DSH 智能模型路由（Smart Provider）",
  "version": "2.10.3",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --unit",
    "prepublishOnly": "npm run test:unit"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.4.0-0"
  },
  "description": "一个 DSH 元提供商，智能调度已配置的模型路由，支持额度自动切换、多账号池与离线成本统计。",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "smart-provider",
    "model-router",
    "meta-provider",
    "failover",
    "模型路由",
    "智能调度",
    "成本统计"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.4.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.4.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.4.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "schema.js",
    "lib",
    "locale/*.json",
    "registry",
    "cordis.patch.yml",
    "README*.md",
    "docs",
    "scripts",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
